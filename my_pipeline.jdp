pipeline {
    agent any
          
	  environment {
        JAVA_HOME = "/usr/lib/jvm/java-17-openjdk-amd64"
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }


    stages{
        stage('PULL STAGE'){
            steps{
                git 'https://github.com/prachiambadkar2001-collab/Jenkins_pipeline.git'
		echo "Pull success"
            }
		}
        stage('Build Stage'){
            steps{
                echo "Build success"
            }
        }
        stage('Test STAGE'){
            steps{
	    withSonarQubeEnv(credentialsId: 'sonar-creds') {
	    mvn clean verify sonar:sonar \
            -Dsonar.projectKey=my-project-for-build-2 \
            -Dsonar.projectName='my-project-for-build-2' \    
            -Dsonar.host.url=http://3.226.221.191:9000 \
	    }      
                echo "Test success"
            
	    }
        }
        stage('Deploy Stage'){
            steps{
                echo "Deploy success"
            }
        }
    }
}
