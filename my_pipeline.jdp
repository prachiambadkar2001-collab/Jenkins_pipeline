pipeline {
    agent any

    environment {
        JAVA_HOME = "/usr/lib/jvm/java-17-openjdk-amd64"
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {

        stage('PULL STAGE') {
            steps {
                git 'https://github.com/prachiambadkar2001-collab/Jenkins_pipeline.git'
                echo "Pull success"
            }
        }

        stage('Build Stage') {
            steps {
                dir('backend') {
                    sh 'java -version'
                    sh 'mvn clean package -DskipTests'
                }
                echo "Build success"
            }
        }

        stage('Test STAGE') {
            steps {
                withSonarQubeEnv('sonarqube') {
		dir('backend') {
                    sh '''
                        mvn sonar:sonar \
                        -Dsonar.projectKey=my-project-for-build-2 \
                        -Dsonar.projectName=my-project-for-build-2
                    '''
                }
		}
                echo "Test success and added webhook as well in automation"  
            }
	}


        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
                echo "Quality Gate Success with webhook after git auto-push"
            }
        }




        stage('Deploy Stage') {
            steps {
                echo "Deploy success"
            }
        }
    }
}
