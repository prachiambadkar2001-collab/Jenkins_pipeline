pipeline {

  agent any

  environment{
      JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
      PATH = "${JAVA_HOME}/bin:${env.PATH}"

  }
  

  stages{
    
    stage('Pull Stage'){
      steps{
         git 'https://github.com/prachiambadkar2001-collab/Jenkins_pipeline.git'
	 echo"pull success"
      }
     
    }


    stage('Test/Plan Stage'){
      steps{
         sh'terraform init -reconfigure
                terraform plan'
         echo"Plan success"
      }

    }
   
    stage('APPROVAL') {
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input message: 'Approval is required. Shall we proceed?, OK : "Approve"'
        }
      }
    }

    stage('Apply/Deploy Stage'){
      steps{
         sh 'terraform apply --auto-approve'       
         echo"Deploy success"
      }  
    }



  }


}
